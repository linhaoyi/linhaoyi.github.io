="line">120</span><br><span class="line">121</span><br><span class="line">122</span><br><span class="line">123</span><br><span class="line">124</span><br><span class="line">125</span><br><span class="line">126</span><br><span class="line">127</span><br><span class="line">128</span><br><span class="line">129</span><br><span class="line">130</span><br><span class="line">131</span><br><span class="line">132</span><br><span class="line">133</span><br><span class="line">134</span><br><span class="line">135</span><br><span class="line">136</span><br><span class="line">137</span><br><span class="line">138</span><br><span class="line">139</span><br><span class="line">140</span><br><span class="line">141</span><br><span class="line">142</span><br><span class="line">143</span><br><span class="line">144</span><br><span class="line">145</span><br><span class="line">146</span><br><span class="line">147</span><br><span class="line">148</span><br><span class="line">149</span><br><span class="line">150</span><br><span class="line">151</span><br><span class="line">152</span><br><span class="line">153</span><br><span class="line">154</span><br><span class="line">155</span><br><span class="line">156</span><br><span class="line">157</span><br><span class="line">158</span><br><span class="line">159</span><br><span class="line">160</span><br><span class="line">161</span><br><span class="line">162</span><br><span class="line">163</span><br><span class="line">164</span><br><span class="line">165</span><br><span class="line">166</span><br><span class="line">167</span><br><span class="line">168</span><br><span class="line">169</span><br><span class="line">170</span><br><span class="line">171</span><br><span class="line">172</span><br><span class="line">173</span><br><span class="line">174</span><br><span class="line">175</span><br><span class="line">176</span><br><span class="line">177</span><br><span class="line">178</span><br><span class="line">179</span><br><span class="line">180</span><br><span class="line">181</span><br><span class="line">182</span><br><span class="line">183</span><br><span class="line">184</span><br><span class="line">185</span><br><span class="line">186</span><br><span class="line">187</span><br><span class="line">188</span><br><span class="line">189</span><br><span class="line">190</span><br><span class="line">191</span><br><span class="line">192</span><br><span class="line">193</span><br><span class="line">194</span><br><span class="line">195</span><br><span class="line">196</span><br><span class="line">197</span><br><span class="line">198</span><br><span class="line">199</span><br><span class="line">200</span><br><span class="line">201</span><br><span class="line">202</span><br><span class="line">203</span><br><span class="line">204</span><br><span class="line">205</span><br><span class="line">206</span><br><span class="line">207</span><br></pre></td><td class="code"><pre><code class="hljs python"><br><span class="hljs-keyword">import</span> subprocess<br><span class="hljs-keyword">import</span> glob<br><span class="hljs-keyword">import</span> sys<br><span class="hljs-keyword">import</span> time<br><span class="hljs-keyword">from</span> datetime <span class="hljs-keyword">import</span> timedelta<br><br><span class="hljs-keyword">def</span> <span class="hljs-title function_">convert_m4s_to_mp3</span>(<span class="hljs-params">directory_path</span>):<br>    <span class="hljs-string">&quot;&quot;&quot;</span><br><span class="hljs-string">    将指定目录中的所有m4s文件转换为标准音质的mp3文件</span><br><span class="hljs-string">    &quot;&quot;&quot;</span><br>    <span class="hljs-comment"># 检查目录是否存在</span><br>    <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> os.path.isdir(directory_path):<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;错误：目录 &#x27;<span class="hljs-subst">&#123;directory_path&#125;</span>&#x27; 不存在！&quot;</span>)<br>        <span class="hljs-keyword">return</span><br>    <br>    <span class="hljs-comment"># 查找所有的m4s文件</span><br>    m4s_files = glob.glob(os.path.join(directory_path, <span class="hljs-string">&quot;*.m4s&quot;</span>))<br>    <br>    <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> m4s_files:<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;在指定目录中未找到任何.m4s文件！&quot;</span>)<br>        <span class="hljs-keyword">return</span><br>    <br>    <span class="hljs-comment"># 显示找到的文件</span><br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;找到以下m4s文件：&quot;</span>)<br>    total_size = <span class="hljs-number">0</span><br>    <span class="hljs-keyword">for</span> i, file <span class="hljs-keyword">in</span> <span class="hljs-built_in">enumerate</span>(m4s_files, <span class="hljs-number">1</span>):<br>        file_size = os.path.getsize(file) / (<span class="hljs-number">1024</span> * <span class="hljs-number">1024</span>)  <span class="hljs-comment"># 转换为MB</span><br>        total_size += file_size<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;<span class="hljs-subst">&#123;i&#125;</span>. <span class="hljs-subst">&#123;os.path.basename(file)&#125;</span> (<span class="hljs-subst">&#123;file_size:<span class="hljs-number">.2</span>f&#125;</span> MB)&quot;</span>)<br>    <br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;\n总共找到 <span class="hljs-subst">&#123;<span class="hljs-built_in">len</span>(m4s_files)&#125;</span> 个m4s文件，总大小: <span class="hljs-subst">&#123;total_size:<span class="hljs-number">.2</span>f&#125;</span> MB&quot;</span>)<br>    <br>    <span class="hljs-comment"># 转换统计</span><br>    success_count = <span class="hljs-number">0</span><br>    fail_count = <span class="hljs-number">0</span><br>    failed_files = []<br>    <br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;\n开始转换文件...&quot;</span>)<br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;=&quot;</span> * <span class="hljs-number">50</span>)<br>    <br>    <span class="hljs-comment"># 记录总开始时间</span><br>    total_start_time = time.time()<br>    <br>    <span class="hljs-keyword">for</span> index, m4s_file <span class="hljs-keyword">in</span> <span class="hljs-built_in">enumerate</span>(m4s_files, <span class="hljs-number">1</span>):<br>        <span class="hljs-keyword">try</span>:<br>            <span class="hljs-comment"># 生成输出文件名</span><br>            base_name = os.path.splitext(m4s_file)[<span class="hljs-number">0</span>]<br>            mp3_file = base_name + <span class="hljs-string">&quot;.mp3&quot;</span><br>            <br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;[<span class="hljs-subst">&#123;index&#125;</span>/<span class="hljs-subst">&#123;<span class="hljs-built_in">len</span>(m4s_files)&#125;</span>] 正在转换: <span class="hljs-subst">&#123;os.path.basename(m4s_file)&#125;</span>&quot;</span>)<br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;     输出: <span class="hljs-subst">&#123;os.path.basename(mp3_file)&#125;</span>&quot;</span>)<br>            <br>            <span class="hljs-comment"># 记录单个文件开始时间</span><br>            file_start_time = time.time()<br>            <br>            <span class="hljs-comment"># 构建FFmpeg命令</span><br>            <span class="hljs-comment"># -y: 覆盖已存在的输出文件</span><br>            <span class="hljs-comment"># -i: 输入文件</span><br>            <span class="hljs-comment"># -acodec libmp3lame: 使用MP3编码器</span><br>            <span class="hljs-comment"># -b:a 128k: 设置音频比特率为128kbps（标准音质）</span><br>            <span class="hljs-comment"># -ar 44100: 采样率44.1kHz</span><br>            <span class="hljs-comment"># -ac 2: 立体声</span><br>            cmd = [<br>                <span class="hljs-string">&#x27;ffmpeg&#x27;</span>, <span class="hljs-string">&#x27;-y&#x27;</span>, <span class="hljs-string">&#x27;-i&#x27;</span>, m4s_file,<br>                <span class="hljs-string">&#x27;-acodec&#x27;</span>, <span class="hljs-string">&#x27;libmp3lame&#x27;</span>, <span class="hljs-string">&#x27;-b:a&#x27;</span>, <span class="hljs-string">&#x27;128k&#x27;</span>,<br>                <span class="hljs-string">&#x27;-ar&#x27;</span>, <span class="hljs-string">&#x27;44100&#x27;</span>, <span class="hljs-string">&#x27;-ac&#x27;</span>, <span class="hljs-string">&#x27;2&#x27;</span>,<br>                <span class="hljs-string">&#x27;-hide_banner&#x27;</span>, <span class="hljs-string">&#x27;-loglevel&#x27;</span>, <span class="hljs-string">&#x27;error&#x27;</span>,  <span class="hljs-comment"># 减少输出信息</span><br>                mp3_file<br>            ]<br>            <br>            <span class="hljs-comment"># 运行FFmpeg命令</span><br>            result = subprocess.run(cmd, capture_output=<span class="hljs-literal">True</span>, text=<span class="hljs-literal">True</span>, timeout=<span class="hljs-number">300</span>)<br>            <br>            <span class="hljs-comment"># 计算单个文件转换时间</span><br>            file_time = time.time() - file_start_time<br>            <br>            <span class="hljs-keyword">if</span> result.returncode == <span class="hljs-number">0</span>:<br>                <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;✓ 成功转换 (<span class="hljs-subst">&#123;file_time:<span class="hljs-number">.1</span>f&#125;</span>秒)&quot;</span>)<br>                success_count += <span class="hljs-number">1</span><br>            <span class="hljs-keyword">else</span>:<br>                <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;✗ 转换失败 (<span class="hljs-subst">&#123;file_time:<span class="hljs-number">.1</span>f&#125;</span>秒)&quot;</span>)<br>                <span class="hljs-keyword">if</span> result.stderr:<br>                    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;   错误: <span class="hljs-subst">&#123;result.stderr.splitlines()[<span class="hljs-number">0</span>] <span class="hljs-keyword">if</span> result.stderr <span class="hljs-keyword">else</span> <span class="hljs-string">&#x27;未知错误&#x27;</span>&#125;</span>&quot;</span>)<br>                fail_count += <span class="hljs-number">1</span><br>                failed_files.append(m4s_file)<br>                <br>        <span class="hljs-keyword">except</span> subprocess.TimeoutExpired:<br>            file_time = time.time() - file_start_time<br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;✗ 转换超时 (<span class="hljs-subst">&#123;file_time:<span class="hljs-number">.1</span>f&#125;</span>秒)&quot;</span>)<br>            fail_count += <span class="hljs-number">1</span><br>            failed_files.append(m4s_file)<br>        <span class="hljs-keyword">except</span> Exception <span class="hljs-keyword">as</span> e:<br>            file_time = time.time() - file_start_time <span class="hljs-keyword">if</span> <span class="hljs-string">&#x27;file_start_time&#x27;</span> <span class="hljs-keyword">in</span> <span class="hljs-built_in">locals</span>() <span class="hljs-keyword">else</span> <span class="hljs-number">0</span><br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;✗ 转换出错 (<span class="hljs-subst">&#123;file_time:<span class="hljs-number">.1</span>f&#125;</span>秒) - <span class="hljs-subst">&#123;<span class="hljs-built_in">str</span>(e)&#125;</span>&quot;</span>)<br>            fail_count += <span class="hljs-number">1</span><br>            failed_files.append(m4s_file)<br>        <br>        <span class="hljs-comment"># 显示进度和预估剩余时间</span><br>        <span class="hljs-keyword">if</span> index &lt; <span class="hljs-built_in">len</span>(m4s_files):<br>            elapsed_time = time.time() - total_start_time<br>            avg_time_per_file = elapsed_time / index<br>            remaining_files = <span class="hljs-built_in">len</span>(m4s_files) - index<br>            estimated_remaining_time = avg_time_per_file * remaining_files<br>            <br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;   进度: <span class="hljs-subst">&#123;index&#125;</span>/<span class="hljs-subst">&#123;<span class="hljs-built_in">len</span>(m4s_files)&#125;</span> | &quot;</span><br>                  <span class="hljs-string">f&quot;剩余时间: <span class="hljs-subst">&#123;timedelta(seconds=<span class="hljs-built_in">int</span>(estimated_remaining_time))&#125;</span>&quot;</span>)<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;-&quot;</span> * <span class="hljs-number">40</span>)<br>    <br>    <span class="hljs-comment"># 计算总用时</span><br>    total_time = time.time() - total_start_time<br>    <br>    <span class="hljs-comment"># 输出转换结果</span><br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;\n&quot;</span> + <span class="hljs-string">&quot;=&quot;</span>*<span class="hljs-number">60</span>)<br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;转换完成！&quot;</span>)<br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;总用时: <span class="hljs-subst">&#123;timedelta(seconds=<span class="hljs-built_in">int</span>(total_time))&#125;</span>&quot;</span>)<br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;总文件数: <span class="hljs-subst">&#123;<span class="hljs-built_in">len</span>(m4s_files)&#125;</span>&quot;</span>)<br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;成功转换: <span class="hljs-subst">&#123;success_count&#125;</span>&quot;</span>)<br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;转换失败: <span class="hljs-subst">&#123;fail_count&#125;</span>&quot;</span>)<br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;成功率: <span class="hljs-subst">&#123;success_count/<span class="hljs-built_in">len</span>(m4s_files)*<span class="hljs-number">100</span>:<span class="hljs-number">.1</span>f&#125;</span>%&quot;</span>)<br>    <br>    <span class="hljs-keyword">if</span> failed_files:<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;\n失败的文件:&quot;</span>)<br>        <span class="hljs-keyword">for</span> file <span class="hljs-keyword">in</span> failed_files:<br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;  - <span class="hljs-subst">&#123;os.path.basename(file)&#125;</span>&quot;</span>)<br>    <br>    <span class="hljs-comment"># 询问是否删除原m4s文件</span><br>    <span class="hljs-keyword">if</span> success_count &gt; <span class="hljs-number">0</span>:<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;\n&quot;</span> + <span class="hljs-string">&quot;=&quot;</span>*<span class="hljs-number">60</span>)<br>        <span class="hljs-keyword">while</span> <span class="hljs-literal">True</span>:<br>            choice = <span class="hljs-built_in">input</span>(<span class="hljs-string">&quot;是否删除原m4s文件？(y/n): &quot;</span>).strip().lower()<br>            <span class="hljs-keyword">if</span> choice <span class="hljs-keyword">in</span> [<span class="hljs-string">&#x27;y&#x27;</span>, <span class="hljs-string">&#x27;yes&#x27;</span>, <span class="hljs-string">&#x27;是&#x27;</span>]:<br>                delete_start_time = time.time()<br>                delete_original_files(m4s_files, failed_files)<br>                delete_time = time.time() - delete_start_time<br>                <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;删除操作用时: <span class="hljs-subst">&#123;delete_time:<span class="hljs-number">.1</span>f&#125;</span>秒&quot;</span>)<br>                <span class="hljs-keyword">break</span><br>            <span class="hljs-keyword">elif</span> choice <span class="hljs-keyword">in</span> [<span class="hljs-string">&#x27;n&#x27;</span>, <span class="hljs-string">&#x27;no&#x27;</span>, <span class="hljs-string">&#x27;否&#x27;</span>]:<br>                <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;已保留原m4s文件。&quot;</span>)<br>                <span class="hljs-keyword">break</span><br>            <span class="hljs-keyword">else</span>:<br>                <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;请输入 y 或 n&quot;</span>)<br><br><span class="hljs-keyword">def</span> <span class="hljs-title function_">delete_original_files</span>(<span class="hljs-params">all_files, failed_files</span>):<br>    <span class="hljs-string">&quot;&quot;&quot;</span><br><span class="hljs-string">    删除原始m4s文件，但跳过转换失败的文件</span><br><span class="hljs-string">    &quot;&quot;&quot;</span><br>    deleted_count = <span class="hljs-number">0</span><br>    files_to_delete = [f <span class="hljs-keyword">for</span> f <span class="hljs-keyword">in</span> all_files <span class="hljs-keyword">if</span> f <span class="hljs-keyword">not</span> <span class="hljs-keyword">in</span> failed_files]<br>    <br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;\n开始删除 <span class="hljs-subst">&#123;<span class="hljs-built_in">len</span>(files_to_delete)&#125;</span> 个原m4s文件...&quot;</span>)<br>    <br>    <span class="hljs-keyword">for</span> file <span class="hljs-keyword">in</span> files_to_delete:<br>        <span class="hljs-keyword">try</span>:<br>            os.remove(file)<br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;✓ 已删除: <span class="hljs-subst">&#123;os.path.basename(file)&#125;</span>&quot;</span>)<br>            deleted_count += <span class="hljs-number">1</span><br>        <span class="hljs-keyword">except</span> Exception <span class="hljs-keyword">as</span> e:<br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;✗ 删除失败 <span class="hljs-subst">&#123;os.path.basename(file)&#125;</span>: <span class="hljs-subst">&#123;<span class="hljs-built_in">str</span>(e)&#125;</span>&quot;</span>)<br>    <br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;\n总共删除了 <span class="hljs-subst">&#123;deleted_count&#125;</span> 个原m4s文件&quot;</span>)<br><br><span class="hljs-keyword">def</span> <span class="hljs-title function_">format_time</span>(<span class="hljs-params">seconds</span>):<br>    <span class="hljs-string">&quot;&quot;&quot;格式化时间显示&quot;&quot;&quot;</span><br>    <span class="hljs-keyword">return</span> <span class="hljs-built_in">str</span>(timedelta(seconds=<span class="hljs-built_in">int</span>(seconds)))<br><br><span class="hljs-keyword">def</span> <span class="hljs-title function_">main</span>():<br>    <span class="hljs-string">&quot;&quot;&quot;</span><br><span class="hljs-string">    主函数</span><br><span class="hljs-string">    &quot;&quot;&quot;</span><br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;M4S 转 MP3 转换器&quot;</span>)<br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;=&quot;</span> * <span class="hljs-number">40</span>)<br>    <br>    <span class="hljs-comment"># 检查FFmpeg是否可用</span><br>    <span class="hljs-keyword">try</span>:<br>        result = subprocess.run([<span class="hljs-string">&#x27;ffmpeg&#x27;</span>, <span class="hljs-string">&#x27;-version&#x27;</span>], capture_output=<span class="hljs-literal">True</span>, text=<span class="hljs-literal">True</span>, check=<span class="hljs-literal">True</span>)<br>        version_line = result.stdout.split(<span class="hljs-string">&#x27;\n&#x27;</span>)[<span class="hljs-number">0</span>]<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;✓ FFmpeg 可用: <span class="hljs-subst">&#123;version_line&#125;</span>&quot;</span>)<br>    <span class="hljs-keyword">except</span> (subprocess.CalledProcessError, FileNotFoundError):<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;✗ 错误: 未找到FFmpeg，请确保已将其添加到环境变量中&quot;</span>)<br>        <span class="hljs-built_in">input</span>(<span class="hljs-string">&quot;按回车键退出...&quot;</span>)<br>        <span class="hljs-keyword">return</span><br>    <br>    <span class="hljs-comment"># 获取用户输入</span><br>    <span class="hljs-keyword">while</span> <span class="hljs-literal">True</span>:<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;\n请输入包含m4s文件的目录路径:&quot;</span>)<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;(可以直接拖拽文件夹到此处)&quot;</span>)<br>        directory_path = <span class="hljs-built_in">input</span>(<span class="hljs-string">&quot;路径: &quot;</span>).strip().strip(<span class="hljs-string">&#x27;&quot;&#x27;</span>)<br>        <br>        <span class="hljs-keyword">if</span> directory_path:<br>            <span class="hljs-keyword">if</span> os.path.isdir(directory_path):<br>                <span class="hljs-keyword">break</span><br>            <span class="hljs-keyword">else</span>:<br>                <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;错误：目录不存在，请重新输入！&quot;</span>)<br>        <span class="hljs-keyword">else</span>:<br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;路径不能为空，请重新输入！&quot;</span>)<br>    <br>    <span class="hljs-comment"># 执行转换</span><br>    convert_start_time = time.time()<br>    convert_m4s_to_mp3(directory_path)<br>    total_script_time = time.time() - convert_start_time<br>    <br>    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;\n脚本总运行时间: <span class="hljs-subst">&#123;format_time(total_script_time)&#125;</span>&quot;</span>)<br>    <span class="hljs-built_in">input</span>(<span class="hljs-string">&quot;\n按回车键退出...&quot;</span>)<br><br><span class="hljs-keyword">if</span> __name__ == <span class="hljs-string">&quot;__main__&quot;</span>:<br>    main()<br></code></pre></td></tr></table></figure>]]></content>
    
    
    
